{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies"
  ],
  "rangeStrategy": "pin",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/charts/paperless-ngx/Chart\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+appVersion: (?<currentValue>\\S+)"
      ],
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/charts/mediumauth/Chart\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+appVersion: (?<currentValue>\\S+)"
      ],
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/charts/stalwart/Chart\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+appVersion: (?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Deprecated charts no longer receive updates",
      "matchFileNames": [
        "charts/grist/**",
        "charts/documenso/**"
      ],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "ghcr.io/paperless-ngx/paperless-ngx"
      ],
      "groupName": "paperless-ngx app",
      "bumpVersions": [
        {
          "filePatterns": [
            "charts/paperless-ngx/Chart.yaml"
          ],
          "matchStrings": [
            "version:\\s(?<version>\\d+\\.\\d+\\.\\d+)"
          ],
          "bumpType": "patch"
        }
      ]
    },
    {
      "matchPackageNames": [
        "ghcr.io/pr0ton11/mediumauth"
      ],
      "groupName": "mediumauth app",
      "bumpVersions": [
        {
          "filePatterns": [
            "charts/mediumauth/Chart.yaml"
          ],
          "matchStrings": [
            "version:\\s(?<version>\\d+\\.\\d+\\.\\d+)"
          ],
          "bumpType": "patch"
        }
      ]
    },
    {
      "matchPackageNames": [
        "stalwartlabs/stalwart"
      ],
      "groupName": "stalwart app",
      "bumpVersions": [
        {
          "filePatterns": [
            "charts/stalwart/Chart.yaml"
          ],
          "matchStrings": [
            "version:\\s(?<version>\\d+\\.\\d+\\.\\d+)"
          ],
          "bumpType": "patch"
        }
      ]
    }
  ]
}
